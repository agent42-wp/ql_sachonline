# Cấu hình kết nối MariaDB (chỉ nội bộ 127.0.0.1 trên VPS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sachonline
DB_USER=sachonline_app
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Cấu hình bảo mật JWT & Cookie (tạo khóa bằng: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
# Đặt false khi chạy HTTP nội bộ (Bài 2), đặt true khi có HTTPS (Bài nhóm)
COOKIE_SECURE=false

# Cấu hình ứng dụng
APP_TITLE=SachOnline - Quan Ly Sach Online (vps-2324802010261)
APP_HOST=127.0.0.1
APP_PORT=8000
